{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/s/:id",
      "destination": "/api/archive?view=story&id=:id"
    },
    {
      "source": "/edition/:date",
      "destination": "/api/archive?view=edition&date=:date"
    },
    {
      "source": "/archives",
      "destination": "/api/archive?view=index"
    },
    {
      "source": "/archives/:month",
      "destination": "/api/archive?view=index&month=:month"
    },
    {
      "source": "/rubrique/:slug",
      "destination": "/api/archive?view=list&kind=rubrique&slug=:slug"
    },
    {
      "source": "/rubrique/:slug/:page",
      "destination": "/api/archive?view=list&kind=rubrique&slug=:slug&page=:page"
    },
    {
      "source": "/pays/:slug",
      "destination": "/api/archive?view=list&kind=pays&slug=:slug"
    },
    {
      "source": "/pays/:slug/:page",
      "destination": "/api/archive?view=list&kind=pays&slug=:slug&page=:page"
    },
    {
      "source": "/dossier/:slug",
      "destination": "/api/archive?view=list&kind=dossier&slug=:slug"
    },
    {
      "source": "/dossier/:slug/:page",
      "destination": "/api/archive?view=list&kind=dossier&slug=:slug&page=:page"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/archive?view=sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
